{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${displayName}",
  "description": "${description}",
  "authors": [ ${authorEntries} ],
  "contact": {
    "homepage": "${displayUrl}",
    "sources": "${sourceCode}",
    "issues": "${issueTracker}"
  },
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "com.yesman.akytheralabs.fabric.AkytheraLabsFabric"
      }
    ],
    "fabric-datagen": [
      {
        "value": "com.yesman.akytheralabs.fabric.AkytheraLabsFabricDataGen"
      }
    ]
  },
  "accessWidener": "akytheralabs.accesswidener",
  "mixins": [
    "akytheralabs.mixins.json",
    "akytheralabs.fabric.mixins.json",
    "akytheralabs-compat.player_animation_library.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": ">=${minecraft}",
    "java": ">=${javaVersion}",
    "fabric-api": "*",
    "akythera": "*"
  }
}
